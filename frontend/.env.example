# ─────────────────────────────────────────────────────────────────
# CryptoPulse Frontend – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# Base URL of the Spring Boot backend API
# Development: leave empty (Vite dev proxy handles /api → localhost:8080)
# Production (Vercel): set to your Render backend URL
VITE_API_BASE_URL=https://your-cryptopulse-backend.onrender.com/api
